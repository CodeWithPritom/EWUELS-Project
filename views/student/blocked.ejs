<div class="max-w-2xl mx-auto px-4 py-16">
    <div class="bg-white rounded-2xl border border-red-200 p-8 shadow-sm text-center">
        <!-- Warning Icon -->
        <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-6">
            <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/>
            </svg>
        </div>

        <h1 class="text-2xl font-bold text-slate-800 mb-2">Account Temporarily Blocked</h1>

        <div class="inline-flex items-center gap-2 px-3 py-1 bg-red-50 border border-red-200 text-red-700 rounded-lg text-xs font-bold mb-4">
            Block Type: <%= user.block_type || 'Auto' %>
        </div>

        <% if (user.block_reason) { %>
            <p class="text-sm text-slate-600 mb-4 bg-slate-50 p-3 rounded-xl border border-slate-200 italic">
                "<%= user.block_reason %>"
            </p>
        <% } %>

        <p class="text-slate-500 text-sm mb-6">
            <%= user.block_type === 'Auto'
                ? 'Your account was automatically blocked due to unpaid late or damage fines. Once all fines are paid, your account will be automatically unblocked.'
                : 'Your account was manually blocked by lab administration. Please visit the lab staff to resolve this issue.' %>
        </p>

        <!-- Unpaid Fines Table -->
        <% if (unpaidFines && unpaidFines.length > 0) { %>
            <div class="mb-6 text-left border border-slate-200 rounded-xl overflow-hidden">
                <div class="bg-slate-50 px-4 py-2.5 border-b border-slate-200">
                    <h3 class="text-xs font-bold text-slate-700 uppercase tracking-wider">Your Unpaid Fines</h3>
                </div>
                <div class="divide-y divide-slate-100">
                    <% unpaidFines.forEach(fine => { %>
                        <div class="p-3.5 flex items-center justify-between text-sm">
                            <div>
                                <span class="font-bold text-slate-800"><%= fine.equipment_name || 'Equipment Fine' %></span>
                                <span class="ml-2 text-xs font-semibold px-2 py-0.5 rounded bg-red-100 text-red-700"><%= fine.fine_type %></span>
                                <p class="text-xs text-slate-400 mt-0.5"><%= new Date(fine.created_at).toLocaleDateString() %></p>
                            </div>
                            <span class="font-bold text-red-600">৳<%= parseFloat(fine.amount).toFixed(2) %></span>
                        </div>
                    <% }) %>
                </div>
            </div>
        <% } %>

        <div class="flex justify-center gap-3">
            <a href="/student/my-requests" class="px-4 py-2.5 text-sm font-medium text-slate-600 bg-slate-100 rounded-xl hover:bg-slate-200 transition">
                View My Requests
            </a>
            <a href="/student/my-fines" class="px-4 py-2.5 text-sm font-medium text-red-600 bg-red-50 rounded-xl hover:bg-red-100 transition">
                View My Fines
            </a>
        </div>
    </div>
</div>
