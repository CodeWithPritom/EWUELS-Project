<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-8">
        <div>
            <h1 class="text-3xl font-bold text-slate-800">My Requests</h1>
            <p class="text-slate-500 mt-1">Your equipment borrowing history and active requests.</p>
        </div>
        <a href="/student/browse" class="mt-4 sm:mt-0 inline-flex items-center gap-2 px-4 py-2.5 text-sm font-semibold text-white bg-gradient-to-r from-primary-600 to-primary-700 rounded-xl hover:from-primary-700 hover:to-primary-800 transition-all shadow-sm">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            New Request
        </a>
    </div>

    <% if (requests.length === 0) { %>
        <div class="bg-white rounded-2xl border border-slate-200 p-16 text-center">
            <div class="w-20 h-20 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-6">
                <svg class="w-10 h-10 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                </svg>
            </div>
            <h3 class="text-xl font-semibold text-slate-600">No Requests Yet</h3>
            <p class="text-slate-400 mt-2">Browse the equipment catalog to submit your first request.</p>
            <a href="/student/browse" class="inline-flex items-center gap-2 mt-6 px-5 py-2.5 bg-primary-600 text-white rounded-xl hover:bg-primary-700 transition text-sm font-medium">
                Browse Equipment
            </a>
        </div>
    <% } else { %>
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="bg-slate-50 border-b border-slate-200">
                            <th class="text-left px-5 py-3 font-semibold text-slate-600">Equipment</th>
                            <th class="text-left px-5 py-3 font-semibold text-slate-600">Code</th>
                            <th class="text-left px-5 py-3 font-semibold text-slate-600">Duration</th>
                            <th class="text-center px-5 py-3 font-semibold text-slate-600">Status</th>
                            <th class="text-left px-5 py-3 font-semibold text-slate-600">Requested</th>
                            <th class="text-right px-5 py-3 font-semibold text-slate-600">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        <% requests.forEach(req => { %>
                            <%
                                const statusColors = {
                                    'Pending': 'bg-yellow-100 text-yellow-700',
                                    'Approved': 'bg-blue-100 text-blue-700',
                                    'Rejected': 'bg-red-100 text-red-700',
                                    'Cancelled': 'bg-slate-100 text-slate-500',
                                    'Issued': 'bg-emerald-100 text-emerald-700',
                                    'Returned': 'bg-slate-200 text-slate-600'
                                };
                                const statusLabel = req.status === 'Approved' ? 'Reserved' : req.status;

                                // Calculate if within 5-minute cancel window
                                let canCancel = false;
                                let remainingMs = 0;
                                if (req.status === 'Approved' && req.reserved_at) {
                                    const reservedAt = new Date(req.reserved_at);
                                    const now = new Date();
                                    const elapsedMs = now.getTime() - reservedAt.getTime();
                                    const fiveMinMs = 5 * 60 * 1000;
                                    if (elapsedMs < fiveMinMs) {
                                        canCancel = true;
                                        remainingMs = fiveMinMs - elapsedMs;
                                    }
                                }
                            %>
                            <tr class="hover:bg-slate-50/50 transition">
                                <td class="px-5 py-4">
                                    <div class="flex items-center gap-3">
                                        <div class="img-box w-10 h-10 rounded-lg bg-slate-100 flex-shrink-0 overflow-hidden">
                                            <% if (req.image_url) { %>
                                                <img src="<%= req.image_url %>" alt="<%= req.equipment_name %>"
                                                    class="w-full h-full object-cover object-center">
                                            <% } else { %>
                                                <div class="w-full h-full flex items-center justify-center">
                                                    <svg class="w-4 h-4 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                                    </svg>
                                                </div>
                                            <% } %>
                                        </div>
                                        <div>
                                            <p class="font-medium text-slate-800"><%= req.equipment_name %></p>
                                            <p class="text-xs text-slate-400"><%= req.equipment_category %></p>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-5 py-4">
                                    <span class="font-mono text-sm font-bold text-slate-700"><%= req.unique_code %></span>
                                </td>
                                <td class="px-5 py-4">
                                    <span class="text-slate-700"><%= req.duration_value %> <%= req.duration_type === 'Day' ? 'day(s)' : 'min(s)' %></span>
                                </td>
                                <td class="px-5 py-4 text-center">
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-bold <%= statusColors[req.status] || 'bg-slate-100 text-slate-600' %>">
                                        <%= statusLabel %>
                                    </span>
                                    <% if (req.status === 'Cancelled' && req.cancelled_by) { %>
                                        <p class="text-[10px] text-slate-400 mt-0.5">by <%= req.cancelled_by %></p>
                                    <% } %>
                                </td>
                                <td class="px-5 py-4 text-slate-500 text-xs">
                                    <%= new Date(req.requested_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                                    <br>
                                    <%= new Date(req.requested_at).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }) %>
                                </td>
                                <td class="px-5 py-4 text-right">
                                    <% if (canCancel) { %>
                                        <form action="/student/cancel/<%= req.id %>" method="POST" class="inline"
                                            onsubmit="return confirm('Are you sure you want to cancel this request?')">
                                            <button type="submit"
                                                class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-red-600 bg-red-50 rounded-lg hover:bg-red-100 transition">
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                                                </svg>
                                                Cancel
                                            </button>
                                        </form>
                                        <div class="mt-1" id="countdown-<%= req.id %>">
                                            <span class="text-[10px] text-red-400 font-medium countdown-timer" data-remaining="<%= remainingMs %>">
                                                <!-- JS fills this -->
                                            </span>
                                        </div>
                                    <% } else if (req.status === 'Issued' && req.due_at) { %>
                                        <%
                                            const dueAt = new Date(req.due_at);
                                            const now = new Date();
                                            const isOverdue = now > dueAt;
                                        %>
                                        <% if (isOverdue) { %>
                                            <span class="inline-flex items-center px-2 py-1 rounded-lg text-[10px] font-bold bg-red-100 text-red-600">
                                                OVERDUE
                                            </span>
                                        <% } else { %>
                                            <span class="text-xs text-slate-400">
                                                Due: <%= dueAt.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %>
                                            </span>
                                        <% } %>
                                    <% } else { %>
                                        <span class="text-xs text-slate-300">—</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    <% } %>
</div>

<script>
    // Countdown timers for cancel windows
    document.querySelectorAll('.countdown-timer').forEach(el => {
        let remaining = parseInt(el.dataset.remaining);
        if (remaining <= 0) return;

        function updateTimer() {
            if (remaining <= 0) {
                el.textContent = 'Window expired';
                // Hide cancel button
                const form = el.closest('td').querySelector('form');
                if (form) form.style.display = 'none';
                return;
            }

            const mins = Math.floor(remaining / 60000);
            const secs = Math.floor((remaining % 60000) / 1000);
            el.textContent = `${mins}m ${secs}s remaining`;
            remaining -= 1000;
            setTimeout(updateTimer, 1000);
        }

        updateTimer();
    });
</script>
