<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-slate-800">Currently Issued Equipment</h1>
        <p class="text-slate-500 mt-1">Equipment currently handed out to students. Click "Process Return" when an item is returned.</p>
    </div>

    <% if (requests.length === 0) { %>
        <div class="bg-white rounded-2xl border border-slate-200 p-16 text-center">
            <div class="w-20 h-20 bg-emerald-100 rounded-full flex items-center justify-center mx-auto mb-6">
                <svg class="w-10 h-10 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
            </div>
            <h3 class="text-xl font-semibold text-slate-600">No Items Currently Issued</h3>
            <p class="text-slate-400 mt-2">All equipment is safely back in the lab!</p>
        </div>
    <% } else { %>
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="bg-slate-50 border-b border-slate-200">
                            <th class="text-left px-5 py-3 font-semibold text-slate-600">Student</th>
                            <th class="text-left px-5 py-3 font-semibold text-slate-600">Equipment</th>
                            <th class="text-left px-5 py-3 font-semibold text-slate-600">Code</th>
                            <th class="text-left px-5 py-3 font-semibold text-slate-600">Issued At</th>
                            <th class="text-left px-5 py-3 font-semibold text-slate-600">Due At</th>
                            <th class="text-center px-5 py-3 font-semibold text-slate-600">Status</th>
                            <th class="text-right px-5 py-3 font-semibold text-slate-600">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        <% requests.forEach(req => { %>
                            <%
                                const dueAt = new Date(req.due_at);
                                const now = new Date();
                                const isOverdue = now > dueAt;
                            %>
                            <tr class="hover:bg-slate-50/50 transition <%= isOverdue ? 'bg-red-50/40' : '' %>">
                                <td class="px-5 py-4">
                                    <div>
                                        <p class="font-medium text-slate-800"><%= req.user_name %></p>
                                        <p class="text-xs text-slate-400"><%= req.user_email %></p>
                                    </div>
                                </td>
                                <td class="px-5 py-4 font-medium text-slate-700"><%= req.equipment_name %></td>
                                <td class="px-5 py-4">
                                    <span class="font-mono text-sm font-bold text-slate-700"><%= req.unique_code %></span>
                                </td>
                                <td class="px-5 py-4 text-xs text-slate-500">
                                    <%= new Date(req.issued_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %><br>
                                    <%= new Date(req.issued_at).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }) %>
                                </td>
                                <td class="px-5 py-4 text-xs font-semibold <%= isOverdue ? 'text-red-600' : 'text-slate-700' %>">
                                    <%= dueAt.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %><br>
                                    <%= dueAt.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }) %>
                                </td>
                                <td class="px-5 py-4 text-center">
                                    <% if (isOverdue) { %>
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-bold bg-red-100 text-red-700 animate-pulse">
                                            OVERDUE
                                        </span>
                                    <% } else { %>
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-bold bg-emerald-100 text-emerald-700">
                                            ON TIME
                                        </span>
                                    <% } %>
                                </td>
                                <td class="px-5 py-4 text-right">
                                    <a href="/staff/return/<%= req.id %>"
                                        class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-gradient-to-r from-emerald-600 to-emerald-700 hover:from-emerald-700 hover:to-emerald-800 text-white rounded-xl font-semibold text-xs transition shadow-sm">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 15l-3-3m0 0l3-3m-3 3h8M3 12a9 9 0 1118 0 9 9 0 01-18 0z"/>
                                        </svg>
                                        Process Return
                                    </a>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    <% } %>
</div>
