<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Back Link -->
    <a href="/staff/issued" class="inline-flex items-center gap-2 text-sm text-slate-500 hover:text-slate-700 transition mb-6">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Back to Issued List
    </a>

    <!-- Return Details Header -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 mb-6">
        <div class="flex items-start justify-between">
            <div>
                <h1 class="text-2xl font-bold text-slate-800">Process Equipment Return</h1>
                <p class="text-slate-500 mt-1">Item: <span class="font-bold text-slate-700"><%= request.equipment_name %></span> (<span class="font-mono text-primary-600 font-bold"><%= request.unique_code %></span>)</p>
                <p class="text-sm text-slate-500 mt-0.5">Borrower: <span class="font-medium text-slate-700"><%= request.user_name %></span> (<%= request.user_email %>)</p>
            </div>
            <% if (isOverdue) { %>
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-red-100 text-red-700 animate-pulse">
                    OVERDUE
                </span>
            <% } else { %>
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-700">
                    ON TIME
                </span>
            <% } %>
        </div>

        <div class="grid grid-cols-2 gap-4 mt-4 pt-4 border-t border-slate-100 text-xs">
            <div>
                <p class="text-slate-400">Issued At:</p>
                <p class="font-medium text-slate-700"><%= new Date(request.issued_at).toLocaleString() %></p>
            </div>
            <div>
                <p class="text-slate-400">Due At:</p>
                <p class="font-medium <%= isOverdue ? 'text-red-600 font-bold' : 'text-slate-700' %>"><%= new Date(request.due_at).toLocaleString() %></p>
            </div>
        </div>

        <!-- Overdue Fine Preview Alert -->
        <% if (isOverdue) { %>
            <div class="mt-4 p-4 bg-red-50 border border-red-200 rounded-xl flex items-center gap-3">
                <svg class="w-6 h-6 text-red-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.34 16.5c-.77.833.192 2.5 1.732 2.5z"/>
                </svg>
                <div>
                    <p class="text-sm font-bold text-red-800">Late Fine Calculated: ৳<%= lateFinePreview.toFixed(2) %></p>
                    <p class="text-xs text-red-600 mt-0.5">
                        Rate: ৳<%= request.duration_type === 'Day' ? rateDay + '/day' : rateMinute + '/minute' %> (Rounded up). Student will be auto-blocked upon return processing.
                    </p>
                </div>
            </div>
        <% } %>
    </div>

    <!-- Return Form -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
        <form action="/staff/return/<%= request.id %>" method="POST" class="space-y-6">
            <!-- Condition Selector -->
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-3">Return Condition <span class="text-red-500">*</span></label>
                <div class="grid grid-cols-2 gap-4">
                    <label class="relative cursor-pointer">
                        <input type="radio" name="return_condition" value="Good" class="peer sr-only" required checked onclick="toggleDamageInput(false)">
                        <div class="flex flex-col items-center justify-center gap-2 p-4 border-2 border-slate-200 rounded-xl text-center peer-checked:border-emerald-500 peer-checked:bg-emerald-50 peer-checked:text-emerald-700 transition-all hover:border-slate-300">
                            <svg class="w-8 h-8 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                            <div>
                                <p class="font-bold text-sm">Good Condition</p>
                                <p class="text-xs text-slate-400 mt-0.5">Item is intact. Copy returns to Available.</p>
                            </div>
                        </div>
                    </label>

                    <label class="relative cursor-pointer">
                        <input type="radio" name="return_condition" value="Damaged" class="peer sr-only" onclick="toggleDamageInput(true)">
                        <div class="flex flex-col items-center justify-center gap-2 p-4 border-2 border-slate-200 rounded-xl text-center peer-checked:border-red-500 peer-checked:bg-red-50 peer-checked:text-red-700 transition-all hover:border-slate-300">
                            <svg class="w-8 h-8 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.34 16.5c-.77.833.192 2.5 1.732 2.5z"/>
                            </svg>
                            <div>
                                <p class="font-bold text-sm">Damaged</p>
                                <p class="text-xs text-slate-400 mt-0.5">Copy goes to Maintenance. Damage fine applied.</p>
                            </div>
                        </div>
                    </label>
                </div>
            </div>

            <!-- Manual Damage Fine Input (Shown if Damaged selected) -->
            <div id="damageFineContainer" class="hidden">
                <label for="damage_fine_amount" class="block text-sm font-medium text-slate-700 mb-1">Damage Fine Amount (৳) <span class="text-red-500">*</span></label>
                <div class="relative">
                    <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 font-bold">৳</span>
                    <input type="number" step="0.01" min="0" id="damage_fine_amount" name="damage_fine_amount" placeholder="0.00"
                        class="w-full pl-8 pr-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition">
                </div>
                <p class="text-xs text-slate-400 mt-1">Enter estimated repair/replacement cost. Student will be auto-blocked.</p>
            </div>

            <!-- Submit button -->
            <button type="submit"
                class="w-full py-3 px-4 bg-gradient-to-r from-emerald-600 to-emerald-700 text-white font-semibold rounded-xl hover:from-emerald-700 hover:to-emerald-800 transition-all shadow-lg shadow-emerald-500/25 text-sm">
                Process Return
            </button>
        </form>
    </div>
</div>

<script>
    function toggleDamageInput(show) {
        const container = document.getElementById('damageFineContainer');
        const input = document.getElementById('damage_fine_amount');
        if (show) {
            container.classList.remove('hidden');
            input.required = true;
        } else {
            container.classList.add('hidden');
            input.required = false;
            input.value = '';
        }
    }
</script>
