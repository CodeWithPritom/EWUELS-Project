<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-slate-800">Fine Rate Settings</h1>
        <p class="text-slate-500 mt-1">Configure default late fine calculation rates for day-based and minute-based borrowing.</p>
    </div>

    <!-- Card -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-8">
        <form action="/admin/fine-settings" method="POST" class="space-y-6">
            <!-- Rate per Day -->
            <div>
                <label for="late_fine_rate_per_day" class="block text-sm font-semibold text-slate-700 mb-1.5">
                    Late Fine Rate per Day (৳) <span class="text-red-500">*</span>
                </label>
                <div class="relative max-w-xs">
                    <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 font-bold">৳</span>
                    <input type="number" step="0.01" min="0" id="late_fine_rate_per_day" name="late_fine_rate_per_day" required
                        value="<%= rateDay %>"
                        class="w-full pl-8 pr-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition font-semibold text-slate-800">
                </div>
                <p class="text-xs text-slate-400 mt-1">Charged for every overdue day (rounded up to nearest day).</p>
            </div>

            <!-- Rate per Minute -->
            <div>
                <label for="late_fine_rate_per_minute" class="block text-sm font-semibold text-slate-700 mb-1.5">
                    Late Fine Rate per Minute (৳) <span class="text-red-500">*</span>
                </label>
                <div class="relative max-w-xs">
                    <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 font-bold">৳</span>
                    <input type="number" step="0.01" min="0" id="late_fine_rate_per_minute" name="late_fine_rate_per_minute" required
                        value="<%= rateMinute %>"
                        class="w-full pl-8 pr-4 py-2.5 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition font-semibold text-slate-800">
                </div>
                <p class="text-xs text-slate-400 mt-1">Charged for every overdue minute (rounded up to nearest minute).</p>
            </div>

            <!-- Info box -->
            <div class="p-4 bg-primary-50 border border-primary-200 rounded-xl flex items-start gap-3 text-xs text-primary-800">
                <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <div>
                    <p class="font-bold">Rounding Policy (Ceiling Rule):</p>
                    <p class="mt-0.5 text-primary-700">Any fraction of time is rounded UP. 30 seconds overdue counts as 1 minute. 2 hours overdue on a Day-duration item counts as 1 day.</p>
                </div>
            </div>

            <!-- Submit button -->
            <button type="submit"
                class="py-3 px-6 bg-gradient-to-r from-primary-600 to-primary-700 text-white font-semibold rounded-xl hover:from-primary-700 hover:to-primary-800 transition-all shadow-md shadow-primary-500/20 text-sm">
                Save Fine Settings
            </button>
        </form>
    </div>
</div>
